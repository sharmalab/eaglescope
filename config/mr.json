{
  "HOME_URL": "https://github.com/sharmalab/eaglescope/",
  "TITLE": "Eaglescope Demo | MRQy Test",
  "UNIT_OF_GRID_VIEW": [230, 210],
  "MARGIN_OF_GRID_VIEW": [10, 10],
  "RESIZABLE" : "TRUE",
  "DRAGGABLE" : 1,
  "HAS_SETTINGS" : "Anything trurthy is true for these boolean fields, including FALSE.",
  "DATA_RESOURCE_URL": "./config/puneet_new_label_3.csv",
  "DATA_FORMAT": "csv",
  "LAYOUT": "",

  "VISUALIZATION_VIEW_CONFIGURATION": [
    {      
      "id": "Category",
      "title": "Category",
      "description": "Category",
      "chartType": "PIE_CHART",
      "fields": { "x": "Category" },
      "size": [1, 1],
      "priority": 70,
      "designation":"left"
    },
    {
      "id": "mean_matrix",
      "title": "Means",
      "description": "Means",
      "chartType": "PARALLEL_COORDINATES",
      "fields": {
        "y": ["TR","TE","SNR1_mean", "SNR2_mean", "SNR3_mean","SNR4_mean", "CVP_mean", "CJV_mean", "EFC_mean", "FBER_mean"]
      },
      "size": [4, 2],
      "priority": 50
    },
    {
      "id": "Category_bar",
      "title": "Category",
      "description": "Category",
      "chartType": "BAR_CHART",
      "fields":{"x":"Category"},
      "size": [4, 1],
      "priority": 0        
    },
    {
      "id": "PSNR_median_DUR",
      "title": "PSNR_median_DUR",
      "description": "PSNR_median_DUR",
      "chartType": "SCATTER_CHART",
      "fields": { "y": "PSNR_median", "x": "DUR (min)" },
      "size": [2, 2],
      "priority": 50
    },
    {
      "id": "SNR_mean_box",
      "title": "SNR_mean",
      "description": "SNR_mean",
      "chartType": "BOX_PLOT",
      "fields": ["SNR1_mean","SNR2_mean","SNR3_mean","SNR4_mean"],
      "size": [2, 2],
      "priority": 70
    },
    {
      "id": "SNR_median_box",
      "title": "SNR_median",
      "description": "SNR_median",
      "chartType": "BOX_PLOT",
      "fields": ["SNR1_median","SNR2_median","SNR3_median","SNR4_median"],
      "size": [2, 2],
      "priority": 70
    },
    {
      "id": "SNR_std_box",
      "title": "SNR_std",
      "description": "SNR_std",
      "chartType": "BOX_PLOT",
      "fields": ["SNR1_std","SNR2_std","SNR3_std","SNR4_std"],
      "size": [2, 2],
      "priority": 70
    },
    {
      "id": "DeviceSerialNumber",
      "title": "DeviceSerialNumber",
      "description": "DeviceSerialNumber",
      "chartType": "BAR_CHART",
      "fields":{"x":"DeviceSerialNumber"},
      "size": [4, 1],
      "priority": 0        
    },
    {
      "id": "PLANE-vs-SNR_mean",
      "title": "grouped SNR_mean",
      "description": "",
      "chartType": "GROUPED_BAR_CHART",
      "fields":{"x":["PLANE","DeviceSerialNumber","LABEL"],"y":["SNR1_mean","SNR2_mean","SNR3_mean", "SNR4_mean"]},
      "method":"mean",
      "size": [8, 1],
      "priority": 0        
    },
    {
      "id": "DeviceSerialNumber-vs-SNR_std",
      "title": "grouped SNR_std",
      "description": "",
      "chartType": "GROUPED_BAR_CHART",
      "fields":{"x":["DeviceSerialNumber","LABEL","PLANE"],"y":["SNR1_std","SNR2_std","SNR3_std", "SNR4_std"]},
      "method":"mean",
      "size": [8, 1],
      "priority": 0        
    },
    {
      "id": "DeviceSerialNumber-vs-SNR_median",
      "title": "grouped SNR_median",
      "description": "",
      "chartType": "GROUPED_BAR_CHART",
      "fields":{"x":["DeviceSerialNumber","LABEL","PLANE"],"y":["SNR1_median","SNR2_median","SNR3_median", "SNR4_median"]},
      "method":"mean",
      "size": [8, 1],
      "priority": 0        
    },
    {
      "id": "DeviceSerialNumber-vs-PSNR-avg",
      "title": "avg PSNR",
      "description": "",
      "chartType": "BAR_CHART",
      "fields":{"x":"DeviceSerialNumber","y":"PSNR_mean"},
      "method":"mean",
      "size": [4, 1],
      "priority": 0        
    },
    {
      "id": "DeviceSerialNumber-vs-PSNR-std",
      "title": "std PSNR",
      "description": "",
      "chartType": "BAR_CHART",
      "fields":{"x":"DeviceSerialNumber","y":"PSNR_std"},
      "method":"mean",
      "size": [4, 1],
      "priority": 0        
    },
    {
      "id": "DeviceSerialNumber-vs-PSNR-median",
      "title": "median PSNR",
      "description": "",
      "chartType": "BAR_CHART",
      "fields":{"x":"DeviceSerialNumber","y":"PSNR_median"},
      "method":"mean",
      "size": [4, 1],
      "priority": 0        
    },
    {
      "id": "collection_data_table",
      "title": "Collection Data Table",
      "description": "Showing Collection Data",
      "chartType": "VIS_DATA_TABLE",
      "fields": [{
          "dataKey": "SeriesDescription",
