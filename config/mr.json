        },
        {
          "dataKey": "DeviceSerialNumber",
          "label": "Device Serial Number"
        },
        {
          "dataKey": "VRX",
          "label": "VRX"
        },
        {
          "dataKey": "VRY",
          "label": "VRY"
        },
        {
          "dataKey": "VRZ",
          "label": "VRZ"
        },
        {
          "dataKey": "MFS",
          "label": "MFS"
        },
        {
          "dataKey": "TR",
          "label": "TR"
        },
        {
          "dataKey": "TE",
          "label": "TE"
        },
        {
          "dataKey": "DUR (min)",
          "label": "DUR (min)"
          
        },{
          "dataKey": "PSNR_mean",
          "label": "PSNR mean"
        }
      ],
      "size": [6, 2],
      "priority": 10
    }
  ]
}
