        {
          "dataKey": "concept_name",
          "label": "Concept Name"
        },
        {
          "dataKey": "concept_code",
          "label": "Concept Code"
        },
        {
          "dataKey": "Input Value Range",
          "label": "Input Value Range"
        },
        {
          "dataKey": "vocabulary_id",
          "label": "Vocabulary Id"
        }

        
      ],
      "size": [4, 2],
      "priority": 10
